# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database file path for SQLite persistence
DATABASE_PATH=./nexcart.db

# Admin portal credentials (if left empty, claim the first admin account directly on /admin)
ADMIN_EMAIL=
ADMIN_PASSCODE=

# Razorpay Test Mode API credentials (from Razorpay Dashboard -> Test Mode -> API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
